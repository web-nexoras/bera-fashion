# Backend API (Express) base URL — without trailing slash
API_BASE_URL=http://localhost:5000/api/v1

# Browser-visible copy (used only where a direct client call is required)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development only: set true to use local demo data without the backend.
# Production never serves demo fallback data; API outages return 503.
OFFLINE_FALLBACK=false

# Cookie / session
SESSION_COOKIE_NAME=bera_session
AUTH_COOKIE_NAME=bera_auth
# Required in production. Use a unique random value with at least 32 bytes of entropy.
AUTH_SECRET=

# Optional: revalidation windows (seconds)
REVALIDATE_PRODUCTS=60
REVALIDATE_CATEGORY=300
